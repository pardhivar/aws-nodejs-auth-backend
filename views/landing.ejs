<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="auth-page">
    <div class="auth-shell">
      <div class="brand-badge">S3 Image Dashboard</div>
      <h1>Upload images in seconds</h1>
      <p class="subtitle">Sign in to your account or create a new one to start uploading to S3.</p>

      <div class="auth-actions">
        <a href="/login" class="primary-button">Login</a>
        <a href="/register" class="secondary-button">Create account</a>
      </div>
    </div>
  </body>
</html>
